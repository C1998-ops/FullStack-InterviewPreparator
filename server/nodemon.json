{
  "watch": ["server.js", "middleware", "routes", "controllers", "models"],
  "ext": "js,json",
  "ignore": [
    "node_modules/**",
    "temp_*.pdf",
    "*.log",
    ".git/**"
  ],
  "exec": "node server.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "legacyWatch": false
}

