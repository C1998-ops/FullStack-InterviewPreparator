{
  "name": "awesome-javascript-interviews",
  "version": "1.0.0",
  "description": "A curated list of resources for JavaScript Interviews",
  "private": true,
  "scripts": {
    "dev": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build:data": "node scripts/generate-static-data.js",
    "build": "npm run build:data && cd client && npm run build",
    "preview": "cd client && npm run preview",
    "start": "cd server && npm start",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "javascript",
    "interview",
    "preparation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan-paul/Awesome-JavaScript-Interviews.git"
  },
  "bugs": {
    "url": "https://github.com/rohan-paul/Awesome-JavaScript-Interviews/issues"
  },
  "homepage": "https://github.com/rohan-paul/Awesome-JavaScript-Interviews#readme"
}
